{%- liquid
  assign s = section.settings
-%}

<section class="tme-section tme-section--ivory tme-section--tight">
  <div class="tme-wrap">
    <div class="tme-section-head">
      <p class="tme-eyebrow" style="margin: 0;">{{ s.eyebrow | default: 'Your bag' }}</p>
      <h1 class="tme-h2">
        {{ s.heading | default: 'Your bag' }}
        {%- if cart.item_count > 0 -%}
          <span class="tme-body tme-body--muted" style="font-family: var(--tme-font-body); font-size: var(--tme-step-0);">
            ({{ cart.item_count }})
          </span>
        {%- endif -%}
      </h1>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="tme-cart__empty">
        <p class="tme-h3">{{ s.empty_heading | default: 'Nothing here yet' }}</p>
        <p class="tme-body tme-body--muted tme-measure--tight">
          {{- s.empty_body | default: 'Start with a subscription box, or browse the everyday essentials.' -}}
        </p>
        <div style="display: flex; gap: var(--tme-space-xs); flex-wrap: wrap; justify-content: center;">
          <a class="tme-btn tme-btn--primary" href="{{ s.empty_link | default: routes.all_products_collection_url }}">
            {{ s.empty_label | default: 'Start shopping' }}
          </a>
        </div>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="tme-cart">
        <div class="tme-cart__items">
          {%- for item in cart.items -%}
            {%- liquid
              assign plan = item.selling_plan_allocation.selling_plan
              assign unit_saving = item.variant.price | minus: item.final_price
              assign line_saving = unit_saving | times: item.quantity
            -%}
            <div class="tme-cart__row" data-cart-line="{{ forloop.index }}">
              <a class="tme-cart__thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image != blank -%}
                  {{
                    item.image
                    | image_url: width: 220
                    | image_tag: loading: 'lazy', widths: '110, 220', alt: item.image.alt | default: item.product.title
                  }}
                {%- endif -%}
              </a>

              <div class="tme-cart__info">
                <h2 class="tme-cart__name"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="tme-cart__variant">{{ item.variant.title }}</p>
                {%- endunless -%}

                {%- if plan != blank -%}
                  <span class="tme-cart__plan">
                    {%- render 'tme-icon', name: 'repeat' -%}
                    Subscription &middot; {{ plan.options.first.value | default: plan.name }}
                  </span>
                  {%- if line_saving > 0 -%}
                    <p class="tme-cart__saving">
                      Recurring {{ item.final_price | money }} per delivery &middot; saving
                      {{ line_saving | money }}
                    </p>
                  {%- endif -%}
                {%- else -%}
                  <span class="tme-cart__plan tme-pill--once" style="background: rgb(var(--tme-plum-rgb) / 0.07); color: var(--tme-plum);">
                    One-time purchase
                  </span>
                {%- endif -%}

                {%- if item.properties.size > 0 -%}
                  {%- for property in item.properties -%}
                    {%- if property.last != blank and property.first != '_' -%}
                      <p class="tme-cart__variant">{{ property.first }}: {{ property.last }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}

                {%- if item.line_level_discount_allocations.size > 0 -%}
                  {%- for discount in item.line_level_discount_allocations -%}
                    <p class="tme-cart__saving">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
                  {%- endfor -%}
                {%- endif -%}
              </div>

              <div class="tme-cart__controls">
                <div class="tme-cart__qty">
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                    aria-label="Reduce quantity of {{ item.product.title | escape }}"
                    data-cart-decrease
                  >&minus;</a>
                  <label class="tme-visually-hidden" for="tme-qty-{{ forloop.index }}">
                    Quantity for {{ item.product.title | escape }}
                  </label>
                  <input
                    id="tme-qty-{{ forloop.index }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    inputmode="numeric"
                    data-cart-qty
                  >
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                    aria-label="Increase quantity of {{ item.product.title | escape }}"
                    data-cart-increase
                  >+</a>
                </div>

                <span class="tme-cart__line-price">{{ item.final_line_price | money }}</span>

                <a
                  class="tme-cart__remove"
                  href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                  data-cart-remove
                >
                  Remove
                </a>
              </div>
            </div>
          {%- endfor -%}

          <noscript>
            <button class="tme-btn tme-btn--secondary" type="submit" name="update" style="margin-top: var(--tme-space-m);">
              Update bag
            </button>
          </noscript>
        </div>

        <aside class="tme-cart__summary">
          <h2 class="tme-h4">{{ s.summary_heading | default: 'Summary' }}</h2>

          <div class="tme-cart__sum-row">
            <span>Subtotal</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="tme-cart__sum-row">
                <span class="tme-cart__saving">{{ discount.title }}</span>
                <span class="tme-cart__saving">-{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="tme-cart__sum-row tme-cart__sum-row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <p class="tme-plans__note" style="margin: 0;">
            {{- s.tax_note | default: 'Taxes and shipping are calculated at checkout.' -}}
          </p>

          {%- assign has_subscription = false -%}
          {%- for item in cart.items -%}
            {%- if item.selling_plan_allocation != blank -%}
              {%- assign has_subscription = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if has_subscription -%}
            <p class="tme-plans__note" style="margin: 0;">
              {{- s.subscription_note
                | default: 'This bag contains a subscription. The amounts above cover the first delivery; later deliveries recur at the same price until you change or cancel.'
              -}}
            </p>
          {%- endif -%}

          <button class="tme-btn tme-btn--primary tme-btn--block" type="submit" name="checkout">
            {{ s.checkout_label | default: 'Checkout' }}
          </button>

          <a class="tme-link" href="{{ s.continue_link | default: routes.all_products_collection_url }}" style="text-align: center;">
            {{ s.continue_label | default: 'Continue shopping' }}
          </a>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'tme-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "TME Cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Monthly Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bag" },
    { "type": "text", "id": "summary_heading", "label": "Summary heading", "default": "Summary" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" },
    { "type": "url", "id": "continue_link", "label": "Continue shopping link" },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note",
      "default": "Taxes and shipping are calculated at checkout."
    },
    {
      "type": "textarea",
      "id": "subscription_note",
      "label": "Subscription note",
      "default": "This bag contains a subscription. The amounts above cover the first delivery; later deliveries recur at the same price until you change or cancel."
    },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Nothing here yet" },
    {
      "type": "textarea",
      "id": "empty_body",
      "label": "Empty body",
      "default": "Start with a subscription box, or browse the everyday essentials."
    },
    { "type": "text", "id": "empty_label", "label": "Empty button label", "default": "Start shopping" },
    { "type": "url", "id": "empty_link", "label": "Empty button link" }
  ],
  "presets": [
    {
      "name": "TME Cart",
      "category": "The Monthly Edit"
    }
  ]
}
{% endschema %}

{%- liquid
  assign s = section.settings
  assign col = collection
  assign image = s.image | default: col.image
  assign heading = s.heading | default: col.title
  assign body = s.body
  if body == blank
    assign body = col.description
  endif
-%}

<section class="tme-colbanner{% if image != blank %} tme-colbanner--media{% endif %}">
  {%- if image != blank -%}
    <div class="tme-colbanner__media">
      {{
        image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000',
          alt: image.alt | default: heading
      }}
    </div>
    <div class="tme-colbanner__scrim" role="presentation"></div>
  {%- endif -%}

  <div class="tme-colbanner__inner">
    {%- if s.eyebrow != blank -%}
      <p class="tme-eyebrow" style="margin: 0;">{{ s.eyebrow }}</p>
    {%- endif -%}
    <h1 class="tme-display">{{ heading }}</h1>
    {%- if body != blank -%}
      <div class="tme-body tme-body--muted tme-measure">{{ body }}</div>
    {%- endif -%}
    {%- if col.products_count > 0 -%}
      <p class="tme-body tme-body--muted" style="margin: 0; font-size: var(--tme-step--1);">
        {{ col.products_count }}
        {%- if col.products_count == 1 %} product{% else %} products{% endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TME Collection banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Monthly Edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the collection title."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "info": "Defaults to the collection description."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Defaults to the collection image. A pink wash is used when both are empty."
    }
  ],
  "presets": [
    {
      "name": "TME Collection banner",
      "category": "The Monthly Edit"
    }
  ]
}
{% endschema %}

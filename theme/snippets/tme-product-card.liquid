{% doc %}
  Editorial product card used by the brand sections.

  All pricing comes from the product object. Subscription figures are read from
  the first variant's selling plan allocations, so a product with no selling
  plan simply shows its one-time price and no subscription badge.

  @param {object} product - The product to render.
  @param {string} cta_label - Optional button label. Defaults per product type.
  @param {boolean} show_description - Render the short description line.
  @param {string} heading_tag - Heading level for the title (default h3).
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign group = product.selling_plan_groups | first
  assign has_subscription = false
  if group != blank
    assign has_subscription = true
  endif

  comment
    Best available subscription price across the plans attached to this variant.
  endcomment
  assign best_price = variant.price
  assign best_saving = 0
  if has_subscription
    for alloc in variant.selling_plan_allocations
      if alloc.price < best_price
        assign best_price = alloc.price
      endif
    endfor
    assign best_saving = variant.price | minus: best_price
  endif

  assign tag = heading_tag | default: 'h3'
  assign label = cta_label
  if label == blank
    if has_subscription
      assign label = 'Explore & subscribe'
    else
      assign label = 'View product'
    endif
  endif
-%}

<article class="tme-card">
  <a class="tme-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    <span class="tme-card__badges">
      {%- if has_subscription -%}
        <span class="tme-pill tme-pill--sub">Subscription</span>
      {%- endif -%}
      {%- if best_saving > 0 and variant.price > 0 -%}
        {%- assign pct = best_saving | times: 100.0 | divided_by: variant.price | round -%}
        <span class="tme-pill tme-pill--save">Save up to {{ pct }}%</span>
      {%- endif -%}
    </span>

    {%- if product.featured_media != blank -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 990px) 33vw, (min-width: 650px) 50vw, 92vw',
          widths: '300, 450, 600, 800',
          alt: product.featured_media.alt
          | default: product.title
      }}
    {%- else -%}
      <span class="tme-card__fallback">{{ product.title }}</span>
    {%- endif -%}
  </a>

  <div class="tme-card__body">
    <{{ tag }} class="tme-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </{{ tag }}>

    {%- if show_description -%}
      {%- assign blurb = product.description | strip_html | truncatewords: 20 -%}
      {%- if blurb != blank -%}
        <p class="tme-card__desc">{{ blurb }}</p>
      {%- endif -%}
    {%- endif -%}

    <div class="tme-card__price-row">
      {%- if has_subscription and best_saving > 0 -%}
        <span class="tme-card__price">{{ best_price | money }}</span>
        <span class="tme-card__price-note">
          per delivery &middot; {{ variant.price | money }} one-time
        </span>
      {%- else -%}
        <span class="tme-card__price">{{ variant.price | money }}</span>
        {%- unless product.available -%}
          <span class="tme-card__price-note">Currently unavailable</span>
        {%- endunless -%}
      {%- endif -%}
    </div>

    <a class="tme-btn tme-btn--secondary tme-btn--block tme-card__cta" href="{{ product.url }}">
      {{ label }}
    </a>
  </div>
</article>
